# Amadeu Brutus — regras do servidor (Hostinger)

# 1) Um endereço só: https://www.amadeubrutus.com.br (301, mesmo caminho)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^amadeubrutus\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.amadeubrutus.com.br/$1 [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://www.amadeubrutus.com.br/$1 [R=301,L]
  # /index.html vira a raiz
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://www.amadeubrutus.com.br/ [R=301,L]
</IfModule>

# 1b) Mídia captada da TV: acesso bloqueado (403) até a remoção definitiva do repositório.
#     Os originais estão guardados no Drive. Para desfazer, apague este bloco.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^public/videos/thevoice/ - [F,L]
  RewriteRule ^amadeu-brutus-video-original\.mp4$ - [F,L]
  RewriteRule ^public/images/foto-amadeu-brutus-11\.jpeg$ - [F,L]
  RewriteRule ^public/images/foto-amadeu-brutus-12\.jpeg$ - [F,L]
  RewriteRule ^public/images/foto-amadeu-brutus-16\.jpeg$ - [F,L]
  RewriteRule ^public/images/foto-amadeu-brutus-17\.jpeg$ - [F,L]
  RewriteRule ^public/videos/amadeu-brutus-video-06\.mp4$ - [F,L]
  RewriteRule ^Amadeu\x20Brutus\x20a\x20eliminação\.mp4$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20\x20The\x20voice\x20brasil\x202026\x20IV\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20\x20The\x20voice\x20brasil\x202026\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20\x20The\x20voice\x20brasil\x202026_I\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20audição\x20às\x20cegas\x20foto\x20I\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20audição\x20às\x20cegas\x20foto\x20II\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20audição\x20às\x20cegas\x20foto\x20III\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20audição\x20às\x20cegas\x20foto\x20IV\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20audição\x20às\x20cegas\x20foto\x20V\.jpeg$ - [F,L]
  RewriteRule ^public/images/Amadeu\x20Brutus\x20peguei\.jpeg$ - [F,L]
  RewriteRule ^public/images/web/amadeu-brutus-the-voice-audicao-ordinary\.webp$ - [F,L]
  RewriteRule ^public/images/web/amadeu-brutus-the-voice-batalha-chao-de-giz\.jpg$ - [F,L]
