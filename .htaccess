# Amadeu Brutus — regras do servidor (Hostinger)

# 1) Um endereço só: https://www.amadeubrutus.com.br (301, mesmo caminho)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^amadeubrutus\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.amadeubrutus.com.br/$1 [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://www.amadeubrutus.com.br/$1 [R=301,L]
  # /index.html vira a raiz
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://www.amadeubrutus.com.br/ [R=301,L]
</IfModule>

# 2) Página 404 em português
ErrorDocument 404 /404.html

# 3) Cache: HTML sempre conferido; imagens, fontes, áudio e vídeo por 1 ano
#    (arquivo de mídia trocado sempre ganha nome novo)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2|mp3|mp4|m4a)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
