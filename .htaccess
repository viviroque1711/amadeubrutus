  RewriteRule ^public/videos/Amadeu\x20Brutus\x20Rodada\x20de\x20Fogo\x20Human\x20Ragnbone\.mp4$ - [F,L]
  RewriteRule ^public/videos/Amadeu\x20Brutus\x20The\x20Voice\x20Brasil\x202026\x20a\x20apresentação\.mp4$ - [F,L]
  RewriteRule ^public/videos/Amadeu\x20Brutus\x20a\x20eliminação\.mp4$ - [F,L]
  RewriteRule ^public/videos/Amadeu\x20Brutus\x20ordinary\x20audição\x20às\x20cegas\.mp4$ - [F,L]
  RewriteRule ^public/videos/Amadeu\x20Brutus\x20pré\x20audição\x20às\x20cegas\.mp4$ - [F,L]
  RewriteRule ^public/videos/Amadeu\x20Brutus\x20pós\x20peguei\.mp4$ - [F,L]
